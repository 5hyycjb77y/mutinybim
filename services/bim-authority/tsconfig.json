{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@permitzip/bim-kernel": ["../../packages/bim-kernel/src/index.ts"],
      "@permitzip/bim-kernel/types": ["../../packages/bim-kernel/src/types.ts"],
      "@permitzip/bim-kernel/geometry": ["../../packages/bim-kernel/src/geometry.ts"],
      "@permitzip/bim-kernel/registry": ["../../packages/bim-kernel/src/registry/index.ts"],
      "@permitzip/bim-kernel/spaces": ["../../packages/bim-kernel/src/spaces/index.ts"],
      "@permitzip/bim-kernel/services": ["../../packages/bim-kernel/src/services/index.ts"],
      "@permitzip/bim-kernel/categories": ["../../packages/bim-kernel/src/categories/index.ts"],
      "@permitzip/bim-kernel/surfaces": ["../../packages/bim-kernel/src/surfaces/index.ts"],
      "@permitzip/bim-kernel/connections": ["../../packages/bim-kernel/src/connections/index.ts"],
      "@permitzip/bim-kernel/questions": ["../../packages/bim-kernel/src/questions/index.ts"],
      "@permitzip/bim-kernel/blocks": ["../../packages/bim-kernel/src/blocks/index.ts"],
      "@permitzip/bim-kernel/commands": ["../../packages/bim-kernel/src/commands.ts"],
      "@permitzip/bim-kernel/packs": ["../../packages/bim-kernel/src/packs/index.ts"],
      "@permitzip/bim-kernel/placement": ["../../packages/bim-kernel/src/placement/index.ts"],
      "@permitzip/bim-kernel/elements": ["../../packages/bim-kernel/src/elements/index.ts"],
      "@permitzip/bim-kernel/formats": ["../../packages/bim-kernel/src/formats.ts"],
      "@permitzip/bim-kernel/findings": ["../../packages/bim-kernel/src/findings/api.ts"],
      "@permitzip/bim-kernel/lineages": ["../../packages/bim-kernel/src/lineages/index.ts"],
      "@permitzip/bim-kernel/lifecycle": ["../../packages/bim-kernel/src/lifecycle/index.ts"],
      "@permitzip/bim-kernel/basis": ["../../packages/bim-kernel/src/basis/index.ts"],
      "@permitzip/bim-kernel/calc-sheets": ["../../packages/bim-kernel/src/calc-sheets/index.ts"],
      "@permitzip/bim-kernel/policy": ["../../packages/bim-kernel/src/policy/index.ts"],
      "@permitzip/bim-kernel/schedules": ["../../packages/bim-kernel/src/schedules/engine/index.ts"],
      "@permitzip/bim-kernel/intake": ["../../packages/bim-kernel/src/propose/intake.ts"],
      "@permitzip/bim-kernel/rated-routes": ["../../packages/bim-kernel/src/routing/rated-routes.ts"],
      "@permitzip/bim-kernel/typicals": ["../../packages/bim-kernel/src/organization/typicals-extras.ts"],
      "@permitzip/bim-sync": ["../../packages/bim-sync/src/index.ts"],
      "@permitzip/bim-sync/note-locks": ["../../packages/bim-sync/src/note-locks.ts"],
      "@permitzip/bim-sync/branch-limits": ["../../packages/bim-sync/src/branches/limits.ts"],
      "@permitzip/bim-sync/lineages": ["../../packages/bim-sync/src/lineages/index.ts"],
      "@permitzip/bim-ifc": ["../../packages/bim-ifc/src/index.ts"],
      "@permitzip/bim-units": ["../../packages/bim-units/src/index.ts"],
      "@permitzip/bim-units/kinds": ["../../packages/bim-units/src/kind-point.ts"],
      "@permitzip/bim-formula": ["../../packages/bim-formula/src/index.ts"],
      "@permitzip/bim-pack": ["../../packages/bim-pack/src/index.ts"],
      "@permitzip/bim-pack/runtime": ["../../packages/bim-pack/src/runtime.ts"],
      "@permitzip/bim-plugin": ["../../packages/bim-plugin/src/index.ts"],
      "@permitzip/bim-calc": ["../../packages/bim-calc/src/index.ts"],
      "@permitzip/bim-library": ["../../packages/bim-library/src/index.ts"],
      "@permitzip/bim-lint": ["../../packages/bim-lint/src/index.ts"],
      "@permitzip/bim-first-party": ["../../packages/bim-first-party/src/index.ts"],
      "@permitzip/bim-first-party/seed": ["../../packages/bim-first-party/src/seed/index.ts"],
      "@permitzip/bim-pack-electrical/host": ["../../packages/bim-pack-electrical/src/host.ts"],
      "@permitzip/bim-pack-electrical": ["../../packages/bim-pack-electrical/src/index.ts"],
      "@permitzip/bim-pack-electrical/ui": ["../../packages/bim-pack-electrical/src/ui.ts"],
      "@permitzip/bim-pack-plumbing/host": ["../../packages/bim-pack-plumbing/src/host.ts"],
      "@permitzip/bim-pack-plumbing": ["../../packages/bim-pack-plumbing/src/index.ts"],
      "@permitzip/bim-pack-plumbing/ui": ["../../packages/bim-pack-plumbing/src/ui.ts"],
      "@permitzip/bim-pack-mechanical/host": ["../../packages/bim-pack-mechanical/src/host.ts"],
      "@permitzip/bim-pack-mechanical": ["../../packages/bim-pack-mechanical/src/index.ts"],
      "@permitzip/bim-pack-mechanical/ui": ["../../packages/bim-pack-mechanical/src/ui.ts"],
      "@permitzip/bim-pack-mechanical/seed": ["../../packages/bim-pack-mechanical/src/seed/index.ts"],
      "@permitzip/bim-pack-structural": ["../../packages/bim-pack-structural/src/index.ts"],
      "@permitzip/bim-pack-architecture": ["../../packages/bim-pack-architecture/src/index.ts"],
      "@permitzip/bim-pack-architecture/ui": ["../../packages/bim-pack-architecture/src/ui.ts"],
      "@permitzip/bim-pack-civil": ["../../packages/bim-pack-civil/src/index.ts"],
      // The kernel only imports bim-geometry types, and the image ships neither it nor manifold-3d.
      "@permitzip/bim-geometry": ["../../packages/bim-geometry/src/program.ts"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*.ts", "drills/**/*.ts"],
  "exclude": ["node_modules", "src/**/__tests__/**"]
}
