<?xml version="1.0"?>
<!-- Synthetic demo-site. Not a survey and not a client's drawing.
     80 ft east by 50 ft north. Existing ground at 100.00 ft, proposed at 101.25 ft.
     Point text is northing, easting, elevation. -->
<LandXML xmlns="http://www.landxml.org/schema/LandXML-1.2" version="1.2" date="2026-01-15" time="12:00:00">
  <Project name="demo-site"/>
  <Units>
    <Imperial areaUnit="squareFoot" linearUnit="foot" volumeUnit="cubicYard" temperatureUnit="fahrenheit" pressureUnit="inHG"/>
  </Units>
  <Surfaces>
    <Surface name="Existing">
      <Definition surfType="TIN">
        <Pnts>
          <P id="1">0 0 100</P>
          <P id="2">0 80 100</P>
          <P id="3">50 80 100</P>
          <P id="4">50 0 100</P>
        </Pnts>
        <Faces>
          <F>1 2 3</F>
          <F>1 3 4</F>
        </Faces>
      </Definition>
    </Surface>
    <Surface name="Proposed">
      <Definition surfType="TIN">
        <Pnts>
          <P id="1">0 0 101.25</P>
          <P id="2">0 80 101.25</P>
          <P id="3">50 80 101.25</P>
          <P id="4">50 0 101.25</P>
        </Pnts>
        <Faces>
          <F>1 2 3</F>
          <F>1 3 4</F>
        </Faces>
      </Definition>
    </Surface>
  </Surfaces>
</LandXML>
